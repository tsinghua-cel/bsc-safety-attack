# Runtime node data (huge; recreated on each run)
**/.local
**/.local.b
**/.local.bb
node-deploy/.venv
node-deploy/bin
**/build/bin
**/__pycache__

# Collected results (not needed to build or run the experiments)
testdata

# Keep node-deploy.zip and code/*.zip in the Docker context. The base Dockerfile
# expands these archives into the image before removing the archive copies.

# Root repo history is not needed inside the image; the per-experiment
# code/*/.git repos ARE kept so the flow scripts can checkout branches.
/.git
